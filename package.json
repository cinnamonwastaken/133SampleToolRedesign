{
  "name": "ep133sampletool",
  "productName": "EP-133 Sample Tool",
  "version": "1.3.0",
  "description": "EP-133 Sample Tool - 1.3.0",
  "main": "main.js",
  "scripts": {
    "start": "electron . --ozone-platform=wayland",
    "package": "electron-builder"
  },
  "build": {
    "appId": "com.ep133.sampletool",
    "afterPack": "./build/afterPack.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "icon.icns",
      "category": "public.app-category.music",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "${productName} ${version}",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "category": "tool",
      "executableName": "ep133sampletool",
      "icon": "icon.png",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "icon.ico"
    }
  },
  "keywords": [
    "teenage",
    "engineering",
    "ep-133",
    "sample",
    "tool"
  ],
  "author": "homeless",
  "devDependencies": {
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3"
  }
}
